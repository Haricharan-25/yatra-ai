# ==============================================================================
# YatraAI Phase 2 - Environment Configuration Template
# Copy this file to .env (do NOT commit .env with actual keys)
# ==============================================================================

# Backend Port (default: 8080)
PORT=8080

# Nominatim OpenStreetMap Reverse Geocoding Configuration
NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse
NOMINATIM_USER_AGENT=YatraAI-TravelCompanion/1.0 (contact@yatraai.local)
NOMINATIM_TIMEOUT_MS=5000

# OpenStreetMap Overpass Places Configuration
OVERPASS_URL=https://overpass-api.de/api/interpreter
TRIGGER_DIST_MAJOR_LANDMARK=2000.0
TRIGGER_DIST_NORMAL_ATTRACTION=1000.0
TRIGGER_DIST_SCENIC_FEATURE=1500.0
MIN_IMPORTANCE_THRESHOLD=6

# Weather Service Configuration (Open-Meteo open weather API)
WEATHER_URL=https://api.open-meteo.com/v1/forecast

# Journey Story Engine Configuration
JOURNEY_STORY_COOLDOWN_SECONDS=300

# AI Service Configuration
# Phase 2 includes a rich local contextual story generator fallback when AI_API_KEY is unset.
# To connect an external LLM (e.g., OpenAI, Groq, OpenRouter, or Gemini OpenAI-compatible endpoint):
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=15

# CORS Configuration (Spring Boot)
CORS_ALLOWED_ORIGINS=*

# Mobile Frontend Configuration (Expo)
# - For Android Emulator: http://10.0.2.2:8080
# - For Physical Device (same Wi-Fi): http://<YOUR_COMPUTER_LOCAL_IP>:8080
# - For Web / iOS Simulator: http://localhost:8080
EXPO_PUBLIC_API_URL=http://192.168.0.197:8080